#!/bin/bash
set -e

export PATH=$PATH:/sbin:/usr/sbin

GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0m'

KERNEL_VER="6.12.116"
COREUTILS_VER="9.7"
NVIDIA_VER="570.144"
SRC_DIR="src"

REPO_URL="https://arch.kwaslinux.netcraze.pro/"

# Скачивает файл и проверяет, что это действительно архив/образ, а не HTML-заглушка
# (сервер Kwasik при недоступности отдаёт страницу-заглушку с кодом 424,
#  wget без --server-response считает такую загрузку успешной).
download_valid() {
    local url="$1" out="$2" validator="$3"
    rm -f "$out"
    if ! wget -q --show-progress -O "$out" "$url"; then
        rm -f "$out"
        return 1
    fi
    if ! $validator "$out"; then
        echo -e "${RED}[Download] '$url' is not a valid archive (got junk/HTML), discarding.${NC}"
        rm -f "$out"
        return 1
    fi
    return 0
}

is_tar_archive() {
    # Проверяет сигнатуру gzip/xz/zstd в начале файла или корректный tar-магический номер
    local f="$1"
    [ -s "$f" ] || return 1
    case "$(head -c 6 "$f" | od -An -tx1 | tr -d ' \n')" in
        1f8b*)                      return 0 ;;  # gzip (.tar.gz / .cpio.gz)
        fd377a585a00)               return 0 ;;  # xz (.tar.xz)
        28b52ffd*)                  return 0 ;;  # zstd
    esac
    head -c 512 "$f" | dd bs=1 skip=257 count=5 status=none | grep -q ustar
}

is_nvidia_run() {
    # Инсталлятор NVIDIA .run — это shell-скрипт (начинается с "#!/"), в хвосте
    # которого прилеплен self-extracting arhив. Проверяем shebang в начале файла,
    # наличие внутри подписи "NVIDIA" и разумный размер (полный пакет ~358 МБ;
    # HTML-заглушки/обрывки будут заметно меньше).
    local f="$1"
    [ -s "$f" ] || return 1
    head -c 2 "$f" | grep -q '^#!' || return 1
    LC_ALL=C grep -a -m1 -q 'NVIDIA' "$f" || return 1
    [ "$(stat -c %s "$f")" -ge $((10 * 1024 * 1024)) ]
}

echo -e "${BLUE}=== Kwas GNU/Linux Build Script ===${NC}"

fetch_all() {
    echo -e "${BLUE}=== Fetching everything from Kwasik Server ===${NC}"
    mkdir -p "$SRC_DIR"

    local pkgs=("kboot-0.1.kpkg" "kinits-0.1.kpkg" "kwash-0.1.kpkg" "linux-firmware.kpkg")
    for pkg in "${pkgs[@]}"; do
        echo -e "${GREEN}[Fetch] Downloading $pkg...${NC}"
        if download_valid "$REPO_URL/$pkg" "/tmp/$pkg" is_tar_archive; then
            mkdir -p "/tmp/kpkg_extract"
            tar -xf "/tmp/$pkg" -C "/tmp/kpkg_extract"
            
            local install_path="rootfs"
            if [ -f "/tmp/kpkg_extract/about.txt" ]; then
                local parsed_path=$(grep '^INSTALL_PATH=' "/tmp/kpkg_extract/about.txt" | cut -d'"' -f2)
                if [ -n "$parsed_path" ]; then install_path="$parsed_path"; fi
            fi
            
            if [ "$install_path" = "project_root" ]; then
                cp -a "/tmp/kpkg_extract/data/." .
                echo -e "${GREEN}[Fetch] $pkg installed to PROJECT ROOT.${NC}"
            else
                mkdir -p rootfs
                cp -a "/tmp/kpkg_extract/data/." rootfs/
                echo -e "${GREEN}[Fetch] $pkg installed to ROOTFS.${NC}"
            fi
            
            rm -rf "/tmp/$pkg" "/tmp/kpkg_extract"
        else
            echo -e "${RED}[Fetch] Failed to download $pkg.${NC}"
        fi
    done

    echo -e "${GREEN}[Fetch] Downloading sources (linux, coreutils)...${NC}"
    if [ ! -f "$SRC_DIR/linux-${KERNEL_VER}.tar.xz" ]; then
        download_valid "$REPO_URL/linux" "$SRC_DIR/linux-${KERNEL_VER}.tar.xz" is_tar_archive || \
            echo -e "${RED}[Fetch] Failed to download linux sources.${NC}"
    fi
    if [ ! -f "$SRC_DIR/coreutils-${COREUTILS_VER}.tar.xz" ]; then
        download_valid "$REPO_URL/coreutils" "$SRC_DIR/coreutils-${COREUTILS_VER}.tar.xz" is_tar_archive || \
            echo -e "${RED}[Fetch] Failed to download coreutils sources.${NC}"
    fi
    
    echo -e "${GREEN}[Fetch] All files downloaded successfully!${NC}"
}

build_kernel() {
    mkdir -p "$SRC_DIR"
    local kernel_src="$SRC_DIR/linux-${KERNEL_VER}.tar.xz"   # официальный исходник с kernel.org
    local kernel_kpkg="$SRC_DIR/linux-${KERNEL_VER}.kpkg"    # пакет с сервера Kwasik (tar-архив)

    if [ ! -f "$kernel_src" ] && [ ! -f "$kernel_kpkg" ]; then
        echo -e "${GREEN}[Kernel] Downloading from Kwasik Server...${NC}"
        if ! download_valid "$REPO_URL/linux.kpkg" "$kernel_kpkg" is_tar_archive; then
            echo -e "${RED}[Kernel] Server unavailable, falling back to kernel.org...${NC}"
            download_valid "https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-${KERNEL_VER}.tar.xz" \
                "$kernel_src" is_tar_archive || \
            download_valid "https://www.kernel.org/pub/linux/kernel/v6.x/linux-${KERNEL_VER}.tar.xz" \
                "$kernel_src" is_tar_archive
        fi
    fi

    # Определяем, какой из загруженных файлов использовать
    local archive=""
    if [ -f "$kernel_kpkg" ] && is_tar_archive "$kernel_kpkg"; then
        archive="$kernel_kpkg"
    elif [ -f "$kernel_src" ] && is_tar_archive "$kernel_src"; then
        archive="$kernel_src"
    fi

    if [ -z "$archive" ]; then
        echo -e "${RED}[Kernel] No valid kernel archive found in $SRC_DIR (downloads failed).${NC}"
        exit 1
    fi

    if [ ! -f "linux/Makefile" ]; then
        rm -rf linux && mkdir -p linux
        if ! tar -xf "$archive" -C linux --strip-components=1; then
            echo -e "${RED}[Kernel] Failed to extract '$archive' — file is not a valid tar archive.${NC}"
            rm -rf linux
            exit 1
        fi
    fi

    if [ ! -f "linux/arch/x86/boot/bzImage" ]; then
        cd linux
        if [ ! -f ".config" ]; then 
            if [ -f "../configs/kwasik_defconfig" ]; then
                echo -e "${GREEN}[Kernel] Applying custom kwasik_defconfig...${NC}"
                cp ../configs/kwasik_defconfig .config
                make olddefconfig 
            else
                echo -e "${BLUE}[Kernel] No custom config found, using default...${NC}"
                make defconfig
            fi
        fi
        make -j$(nproc)
        cd ..
    fi

    echo -e "${GREEN}[Kernel] Installing modules to rootfs...${NC}"
    local KVER=$(make -s kernelrelease -C linux)

    cd linux
    make -s modules_install INSTALL_MOD_PATH=../rootfs
    cd ..

    echo -e "${GREEN}[Kernel] Stripping debug info...${NC}"
    find rootfs/lib/modules -name "*.ko" -exec strip --strip-debug {} \; 2>/dev/null || true

    echo -e "${GREEN}[Kernel] Generating modules.dep...${NC}"
    depmod -b rootfs "$KVER"
}

build_coreutils() {
    mkdir -p "$SRC_DIR"
    local coreutils_tar="$SRC_DIR/coreutils-${COREUTILS_VER}.tar.xz"

    local CC_STD="gnu2x"
    if echo 'int main(void){return 0;}' | gcc -std=gnu23 -fsyntax-only -x c - 2>/dev/null; then
        CC_STD="gnu23"
    fi
    local CO_CFLAGS="-O2 -std=$CC_STD"
    echo -e "${GREEN}[Coreutils] Using CFLAGS='$CO_CFLAGS'${NC}"

    local coreutils_kpkg="$SRC_DIR/coreutils-${COREUTILS_VER}.kpkg"

    if [ ! -f "$coreutils_tar" ] && [ ! -f "$coreutils_kpkg" ]; then
        echo -e "${GREEN}[Coreutils] Downloading from Kwasik Server...${NC}"
        if ! download_valid "$REPO_URL/coreutils.kpkg" "$coreutils_kpkg" is_tar_archive; then
            echo -e "${RED}[Coreutils] Server unavailable, falling back to ftp.gnu.org...${NC}"
            download_valid "https://ftp.gnu.org/gnu/coreutils/coreutils-${COREUTILS_VER}.tar.xz" \
                "$coreutils_tar" is_tar_archive
        fi
    fi

    local cu_archive=""
    if [ -f "$coreutils_kpkg" ] && is_tar_archive "$coreutils_kpkg"; then
        cu_archive="$coreutils_kpkg"
    elif [ -f "$coreutils_tar" ] && is_tar_archive "$coreutils_tar"; then
        cu_archive="$coreutils_tar"
    fi

    if [ -z "$cu_archive" ]; then
        echo -e "${RED}[Coreutils] No valid coreutils archive found in $SRC_DIR (downloads failed).${NC}"
        exit 1
    fi

    if [ ! -f "coreutils/configure" ] || ! grep -q -- "-std=$CC_STD" coreutils/Makefile 2>/dev/null; then
        rm -rf coreutils && mkdir -p coreutils
        if ! tar -xf "$cu_archive" -C coreutils --strip-components=1; then
            echo -e "${RED}[Coreutils] Failed to extract '$cu_archive' — file is not a valid tar archive.${NC}"
            rm -rf coreutils
            exit 1
        fi
        cd coreutils
        CFLAGS="$CO_CFLAGS" ./configure --prefix=/usr
        cd ..
    fi

    echo -e "${GREEN}[Coreutils] Compiling...${NC}"
    cd coreutils
    make -j$(nproc) CFLAGS="$CO_CFLAGS" MAKEINFO=true
    make install DESTDIR=$PWD/../rootfs
    cd ..
}

build_nvidia() {
    echo -e "${BLUE}=== Building NVIDIA Kernel Modules ${NVIDIA_VER} ===${NC}"
    local NVIDIA_RUN="NVIDIA-Linux-x86_64-${NVIDIA_VER}.run"
    local NVIDIA_TAR="$SRC_DIR/$NVIDIA_RUN"
    local EXTRACT_DIR="nvidia-kmod-${NVIDIA_VER}"
    local KERNEL_TREE="$PWD/linux"

    mkdir -p "$SRC_DIR"

    if [ ! -f "$KERNEL_TREE/Module.symvers" ]; then
        echo -e "${RED}[NVIDIA] Kernel tree not built. Run 'kernel' target first.${NC}"
        exit 1
    fi

    if [ ! -f "$NVIDIA_TAR" ] || ! is_nvidia_run "$NVIDIA_TAR"; then
        rm -f "$NVIDIA_TAR"
        echo "Downloading NVIDIA driver ${NVIDIA_VER} from Kwasik Server..."
        if ! download_valid "$REPO_URL/$NVIDIA_RUN" "$NVIDIA_TAR" is_nvidia_run; then
            echo -e "${RED}[NVIDIA] Server unavailable, falling back to nvidia.com...${NC}"
            download_valid \
                "https://us.download.nvidia.com/XFree86/Linux-x86_64/${NVIDIA_VER}/${NVIDIA_RUN}" \
                "$NVIDIA_TAR" is_nvidia_run
        fi
    fi

    # Проверка, что файл скачан и это действительно инсталлятор
    if [ ! -s "$NVIDIA_TAR" ] || ! is_nvidia_run "$NVIDIA_TAR"; then
        echo -e "${RED}[NVIDIA] Downloaded file is missing or invalid!${NC}"
        exit 1
    fi

    if [ ! -d "$EXTRACT_DIR" ]; then
        echo "Extracting kernel modules..."
        sh "$NVIDIA_TAR" --extract-only
        mv "NVIDIA-Linux-x86_64-${NVIDIA_VER}" "$EXTRACT_DIR"
    fi

    # Подбираем C-компилятор: gcc-14 может отсутствовать в системе,
    # тогда берём обычный gcc (или $CC из окружения).
    local NVIDIA_CC="${CC:-}"
    if [ -z "$NVIDIA_CC" ]; then
        for c in gcc-14 gcc-13 gcc-12 gcc clang; do
            if command -v "$c" >/dev/null 2>&1 && \
               echo 'int main(void){return 0;}' | "$c" -x c - -o /tmp/.kwas_cc_test 2>/dev/null; then
                NVIDIA_CC="$c"
                break
            fi
        done
        rm -f /tmp/.kwas_cc_test
    fi
    if [ -z "$NVIDIA_CC" ]; then
        echo -e "${RED}[NVIDIA] No working C compiler found (tried gcc-14/gcc/clang). Install build-essential.${NC}"
        exit 1
    fi
    echo -e "${GREEN}[NVIDIA] Using C compiler: $NVIDIA_CC${NC}"

    echo -e "${GREEN}[NVIDIA] Compiling kernel modules...${NC}"
    make -C "$EXTRACT_DIR/kernel" \
        modules \
        CC="$NVIDIA_CC" \
        KCFLAGS="-Wno-error=attributes" \
        SYSSRC="$KERNEL_TREE" \
        SYSOUT="$KERNEL_TREE" \
        IGNORE_CC_MISMATCH=1 \
        IGNORE_XEN_PRESENCE=1 \
        IGNORE_PREEMPT_RT_PRESENCE=1 \
        -j$(nproc)

    echo -e "${GREEN}[NVIDIA] Installing modules to rootfs...${NC}"
    local KVER=$(make -s kernelrelease -C "$KERNEL_TREE")
    local MOD_DEST="$PWD/rootfs/lib/modules/$KVER/kernel/drivers/video"
    mkdir -p "$MOD_DEST"

    for ko in "$EXTRACT_DIR"/kernel/*.ko; do
        if [ -f "$ko" ]; then cp -v "$ko" "$MOD_DEST/"; fi
    done

    echo -e "${GREEN}[NVIDIA] Running depmod...${NC}"
    depmod -b rootfs "$KVER"
}

setup_libs() {
    echo -e "${GREEN}[Libs] Copying system libraries...${NC}"
    cd rootfs
    
    rm -rf lib/x86_64-linux-gnu usr/lib/x86_64-linux-gnu
    rm -f lib/libc.so.6 usr/lib/libc.so.6 lib64/ld-linux-x86-64.so.2
    
    mkdir -p lib lib64 usr/lib lib/x86_64-linux-gnu usr/lib/x86_64-linux-gnu

    # Копируем ld-linux (с флагом -L, чтобы скопировать сам файл, а не симлинк)
    local ld_path=""
    for path in /lib64/ld-linux-x86-64.so.2 /usr/lib64/ld-linux-x86-64.so.2 /lib/x86_64-linux-gnu/ld-linux-x86-64.so.2; do
        if [ -f "$path" ]; then ld_path="$path"; break; fi
    done
    if [ -n "$ld_path" ]; then 
        cp -aLf "$ld_path" lib64/ 
    fi

    # Копируем libc.so.6 (тоже с -L)
    local libc_path=""
    for path in /lib/x86_64-linux-gnu/libc.so.6 /usr/lib/x86_64-linux-gnu/libc.so.6 /lib/libc.so.6; do
        if [ -f "$path" ]; then libc_path="$path"; break; fi
    done
    if [ -n "$libc_path" ]; then
        cp -aLf "$libc_path" lib/x86_64-linux-gnu/
        cp -aLf "$libc_path" lib/
        cp -aLf "$libc_path" usr/lib/
    fi

    # Копируем libcap.so.2
    for path in /lib/x86_64-linux-gnu/libcap.so.2 /usr/lib/x86_64-linux-gnu/libcap.so.2 /lib/libcap.so.2; do
        if [ -f "$path" ]; then
            cp -aLf "$path" lib/x86_64-linux-gnu/ 2>/dev/null || true
            cp -aLf "$path" lib/ 2>/dev/null || true
            cp -aLf "$path" usr/lib/ 2>/dev/null || true
            break
        fi
    done

    cd ..
}

build_system() {
    echo -e "${GREEN}[System] Building kinits (init)...${NC}"
    cd kinits && make clean && make && cd ..
    # Проверяем, что init собрался и он именно статический ELF.
    # Если в cpio попадёт динамически слинкованный бинарник или файл без +x,
    # ядро не сможет его запустить (Kernel panic: Failed to execute /init, error -13).
    if ! head -c 5 kinits/init | od -An -tx1 | grep -q '^ 7f 45 4c 46'; then
        echo -e "${RED}[System] kinits/init отсутствует или это не ELF — сборка прервана.${NC}"
        exit 1
    fi
    if ldd kinits/init 2>/dev/null | grep -qv 'not a dynamic'; then
        echo -e "${RED}[System] kinits/init слинкован динамически (в initramfs нет ld.so) — сборка прервана.${NC}"
        exit 1
    fi
    install -m 755 kinits/init rootfs/init

    echo -e "${GREEN}[System] Building kwash (shell)...${NC}"
    cd kwash && make clean && make && cd ..
    install -m 755 kwash/kwash rootfs/bin/kwash

    if [ -d "kutils" ]; then
        echo -e "${GREEN}[System] Building kutils...${NC}"
        cd kutils
        make clean || true
        make
        find . -maxdepth 1 -type f -executable -exec cp -v {} ../rootfs/bin/ \;
        cd ..
    else
        echo -e "${BLUE}[System] Папка kutils не найдена, пропускаем.${NC}"
    fi
}

build_ramfs() {
    echo -e "${GREEN}[Pack] Packing initramfs...${NC}"
    cd rootfs
    
    # Очистка от мусора
    rm -rf lib/modules/*/build lib/modules/*/source

    # Страховка: /init обязан существовать и быть исполняемым, иначе ядро
    # упадёт с "Failed to execute /init (error -13)" → Kernel panic.
    if [ ! -f init ]; then
        echo -e "${RED}[Pack] В rootfs нет /init! Сначала выполните: ./build system${NC}"
        exit 1
    fi
    chmod 755 init 2>/dev/null || true
    chmod -R +x bin sbin usr/bin usr/sbin 2>/dev/null || true

    if [ ! -f etc/profile ]; then
        echo "PATH=/bin:/usr/bin:/sbin" > etc/profile
        echo 'PS1="\e[1;32m[\u@\h \w]\e[0m# "' >> etc/profile
    fi

    # ИСПОЛЬЗУЕМ fakeroot: cpio будет уверен, что файлы принадлежат root
    echo "Packing with fakeroot to set root:root ownership..."
    find . | fakeroot cpio -o -H newc | gzip > ../initramfs.cpio.gz
    
    cd ..
}

build_iso() {
    echo -e "${GREEN}[ISO] Building bootable ISO...${NC}"
    chmod +x buildiso.sh
    ./buildiso.sh
}

clear_all() {
    echo "clearing files"
    rm -rf linux coreutils src nvidia-kmod-570.144 *.iso initramfs.cpio.gz  rootfs/usr/bin rootfs/usr/share rootfs/usr/libexec rootfs/lib/modules rootfs/bin/* rootfs/init kinits/init kwash/kwash kboot/efi/x86_64/kboot.efi 
}

case "$1" in
    fetch)    fetch_all ;;
    kernel)   build_kernel ;;
    utils)    build_coreutils ;;
    nvidia)   build_nvidia ;;
    system)   build_system ;;
    libs)     setup_libs ;;
    pack)     build_ramfs ;;
    iso)      build_iso ;;
    clear)    clear_all ;;
    all) 
        build_kernel
        build_coreutils
        build_nvidia
        setup_libs
        build_system
        build_ramfs
        build_iso
        echo -e "${GREEN}=== Build completed! ===${NC}"
        ;;
    *) echo "Usage: $0 {fetch|all|kernel|utils|nvidia|system|libs|pack|iso|clear}" ;;
esac

#!/bin/bash
set -e

if ! command -v docker &> /dev/null; then
    echo "Ошибка: Docker не установлен. Пожалуйста, установи его."
    exit 1
fi

if ! docker info > /dev/null 2>&1; then
    echo "Ошибка: Docker-демон не запущен или у тебя нет прав."
    echo "Попробуй выполнить: sudo systemctl start docker"
    echo "И убедись, что ты добавил себя в группу docker (sudo usermod -aG docker $USER)."
    exit 1
fi

echo "Сборка Docker-образа (это может занять время в первый раз)..."
docker build -t kwaslinux-builder .

# Определяем, какой скрипт сборки использовать
BUILD_CMD=""
if [ -f "./build" ]; then
    BUILD_CMD="./build"
elif [ -f "./build.sh" ]; then
    BUILD_CMD="./build.sh"
else
    echo "Ошибка: В корне проекта не найден ни файл 'build', ни 'build.sh'!"
    exit 1
fi

echo "Запуск сборки Kwasik внутри контейнера (используется $BUILD_CMD)..."

: "${CFLAGS:=-O2 -std=gnu23}"
: "${CXXFLAGS:=-O2 -std=gnu23}"
export CFLAGS CXXFLAGS

echo "CFLAGS=$CFLAGS"
echo "CXXFLAGS=$CXXFLAGS"

docker run --rm -it \
    -u "$(id -u):$(id -g)" \
    -v "$(pwd):/build" \
    -w /build \
    -e CFLAGS="$CFLAGS" \
    -e CXXFLAGS="$CXXFLAGS" \
    kwaslinux-builder \
    bash -c "chmod +x $BUILD_CMD && $BUILD_CMD $@"
